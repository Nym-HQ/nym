# The Next 16 / React 19 upgrade pulls in a modern toolchain (e.g.
# eslint-config-next@16 peers eslint>=9) alongside packages that still declare
# React 18 / eslint 8 peers. Install with legacy peer resolution so CI/Vercel
# `npm install` matches the committed lockfile (generated the same way) instead
# of failing with ERESOLVE.
legacy-peer-deps=true
